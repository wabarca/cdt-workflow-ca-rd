# ==============================================================================
# .gitignore - CDT 8.0 & Pipeline de Automatización
# ==============================================================================

# --- 1. Archivos de Datos e Insumos Espaciales (No sincronizar datos pesados) ---
/data/**/*
!/data/**/
!/data/**/*.gitkeep
!/data/stations/validation_holdout_stations.csv

# --- 2. Salidas de Experimentos, Grillas NetCDF 3D y Logs de Auditoría ---
/output/**/*
!/output/**/
!/output/**/*.gitkeep

/logs/**/*
!/logs/**/
!/logs/**/*.gitkeep

# Directorios de salida de pruebas temporales
tests/test_station_split/out/

# --- 3. Salvaguarda Global para Formatos Científicos y Binarios Pesados ---
*.nc
*.nc4
*.grb
*.grib
*.grib2
*.hdf
*.h5
*.tar.gz
*.zip
*.gz
*.7z

# --- 4. Entornos Virtuales y Caché de Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- 5. R Package Build, Check & Cache Files ---
.Rhistory
.Rapp.history
.RData
*-Ex.R
/*.tar.gz
/*.Rcheck/
.Rproj.user/
vignettes/*.html
vignettes/*.pdf
src/*.o
src/*.so
.httr-oauth
/*_cache/
/cache/
*.utf8.md
*.knit.md
rsconnect/
R/cdtTest_import.R

# --- 6. Editores, IDEs y Sistema Operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# --- 7. Excepciones Explícitas (Archivos de Configuración que SÍ deben sincronizarse) ---
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.devcontainer/
!/.devcontainer/**
